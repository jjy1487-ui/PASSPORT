      {
       "order": 2,
       "speaker": "심사관",
       "text": "네, 보안 절차가 강화됐습니다. 전신 X-ray 검색부터 할게요. 검색대로 들어가 주시겠어요?"
      },
      {
       "order": 3,
       "speaker": "임가은",
       "text": "아, 네. 여기요. (긴장한 듯 검색대로 들어선다)"
      },
      {
       "order": 4,
       "speaker": "임가은",
       "text": "여권 확인 부탁드립니다."
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 승인",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "즐거운 여행 되십시오."
      },
      {
       "order": 2,
       "speaker": "임가은",
       "text": "감사합니다. 잘 다녀올게요."
      }
     ]
    },
    {
     "caseType": "일반 심사",
