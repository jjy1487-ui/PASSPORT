   "dialogueCases": [
    {
     "caseType": "입장",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "존 카터",
       "text": "Morning. Just here on business — nothing to declare. (안녕하세요. 사업차 왔어요. 신고할 것도 없고요.)"
      },
      {
       "order": 2,
       "speaker": "심사관",
       "text": "요즘 보안이 강화돼서, 오늘부터 수하물도 X-ray로 함께 봅니다. 가방 좀 올려주시겠어요?"
      },
      {
       "order": 3,
       "speaker": "존 카터",
       "text": "Oh. Sure, of course. (아… 네, 그럼요.)"
      },
      {
       "order": 4,
       "speaker": "존 카터",
       "text": "Here's my passport. Please make it quick. (여권 여기 있어요. 빨리 좀 부탁드려요.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 승인",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "확인 완료되었습니다. 지나가셔도 됩니다."
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "...Thank you. (서둘러 이동한다.) (...감사합니다.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "X-ray 검사에서 밀수품이 적발되었습니다. 입국하실 수 없습니다.",
       "claim": {
        "attr": "contraband",
        "value": "밀수품",
        "label": "X-ray 적발물",
        "unlocksScan": ""
       }
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "Sorry about that, I'll sort it out. (죄송해요, 제가 정리하겠습니다.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "잘못 허가",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "서류 검토 결과 입국이 어렵습니다."
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "...Thank you. (서둘러 이동한다.) (...감사합니다.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "잘못 거절",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "죄송합니다. 좀 걸리는 부분이 있어서… 이번엔 입국이 어렵겠습니다."
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "Sorry about that, I'll sort it out. (죄송해요, 제가 정리하겠습니다.)"
      }
     ]
