        },
        {
          "caseType": "일반 심사",
          "gameResult": "정상 승인",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "확인 완료되었습니다. 지나가셔도 됩니다."
            },
            {
              "order": 2,
              "speaker": "윤서린",
              "text": "감사합니다. 역시 알아봐 주시네요."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "정상 거절",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "서류 항목에 문제가 있습니다. 입국은 어렵습니다."
            },
            {
              "order": 2,
              "speaker": "윤서린",
              "text": "사진이랑 다르다고요? 저 본인 맞는데요..."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "잘못 허가",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "지문 인식을 진행하겠습니다. 손을 올려주세요."
            },
            {
              "order": 2,
              "speaker": "윤서린",
              "text": "감사합니다! (안도하며 빠르게 입국한다.)"
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "잘못 거절",
          "rejectCount": 1,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "죄송하지만 입국은 어렵습니다."
            },
            {
              "order": 2,
              "speaker": "윤서린",
              "text": "왜요? 분명히 저 맞는데요."
            },
            {
              "order": 3,
              "speaker": "심사관",
              "text": "다시 확인해보니 서류가 맞네요. 지나가시면 됩니다."
            },
            {
              "order": 4,
              "speaker": "윤서린",
              "text": "거 봐요, 저 맞잖아요."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "잘못 거절",
          "rejectCount": 2,
          "lines": [
            {
              "order": 1,
