        {
          "caseType": "일반 심사",
          "gameResult": "정상 거절",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "잠깐, 모자를 벗어주시겠어요?",
