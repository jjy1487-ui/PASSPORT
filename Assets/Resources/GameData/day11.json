   "dialogueCases": [
    {
     "caseType": "입장",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "윤정호",
       "text": "수고들 많으십니다. (느긋하게) 윤정호요. 외교 일정 마치고 들어가려는데."
      },
      {
       "order": 2,
       "speaker": "윤정호",
       "text": "오래 안 걸리죠? 위에서 기다리는 사람들이 많아서. (여권을 내려놓는다)"
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "의원님, 오늘부터 전원 전신 X-ray 검색을 받으셔야 합니다. 검색대로 들어가 주시겠습니까?"
      },
      {
       "order": 4,
       "speaker": "윤정호",
       "text": "(손을 휘저으며) 됐소, 됐어. 나 같은 사람을 뭘 검사를 해. 그런 건 생략하고 빨리 진행합시다.",
       "claim": {
        "attr": "xray",
        "value": "",
        "label": "전신 검색 거부",
        "unlocksScan": ""
       }
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 1,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "의원님, 전신 X-ray 검색은 오늘부터 예외 없이 전원 필수입니다. 거부하시면 입국이 불가합니다."
      },
      {
       "order": 2,
       "speaker": "윤정호",
       "text": "허, 이 사람 보게. 내가 무슨 밀수꾼이라도 되나? 그냥 좀 넘어갑시다."
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "규정상 검사를 거부하시면 입국하실 수 없습니다."
      },
      {
       "order": 4,
       "speaker": "윤정호",
       "text": "거참 융통성하고는. 나 윤정호요. 이런 걸로 사람 붙잡는 거 아니야."
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 2,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "검사에 응하지 않으시면 입국을 허가할 수 없습니다."
      },
      {
       "order": 2,
       "speaker": "윤정호",
       "text": "(눈썹을 치켜올리며) 자네, 지금 내가 누군지 알고 이러는 건가?"
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "규정은 누구에게나 동일합니다. 검색을 받으시거나, 돌아가셔야 합니다."
      },
      {
       "order": 4,
       "speaker": "윤정호",
       "text": "허, 내가 위에 한마디만 하면 자네 자리가 어떻게 될지 모르는데 말이야."
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 3,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "마지막입니다. 검사 거부 시 입국 불가입니다."
      },
      {
       "order": 2,
       "speaker": "윤정호",
       "text": "(언성을 높이며) 내가 누군지 알고 이러나?! 윗선에 얘기 들어가면 자네 하나 날리는 건 일도 아니야!"
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "그러셔도 규정은 바뀌지 않습니다. 검사를 거부하셨으므로 입국은 거부됩니다."
      },
      {
       "order": 4,
       "speaker": "윤정호",
       "text": "…좋아. 두고 보지. 이 일, 절대 그냥 안 넘어갈 줄 알아. (씩씩대며 돌아선다)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "잘못 허가",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "…입국 허가합니다. 들어가십시오."
      },
      {
       "order": 2,
       "speaker": "윤정호",
       "text": "그럼 그렇지. 진작 그럴 것이지. (거드름 피우며 지나간다)"
      }
     ]
    }
