   "dialogueCases": [
    {
     "caseType": "입장",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "존 카터",
       "text": "Morning, officer. (여유로운 미소로 여권을 내민다.)"
      },
      {
       "order": 2,
       "speaker": "심사관",
       "text": "안녕하세요. 입국 목적이 어떻게 되십니까?"
      },
      {
       "order": 3,
       "speaker": "존 카터",
       "text": "Business. Import-export, mostly. I come through here a couple times a year. (사업이요. 주로 수출입. 일 년에 두어 번씩 옵니다.)"
      },
      {
       "order": 4,
       "speaker": "심사관",
       "text": "머무시는 기간은요?"
      },
      {
       "order": 5,
       "speaker": "존 카터",
       "text": "Three days, four at most. In and out. (사흘, 길어야 나흘. 금방 나가요.)"
      },
      {
       "order": 6,
       "speaker": "심사관",
       "text": "신고하실 물품 있으십니까?"
      },
      {
       "order": 7,
       "speaker": "존 카터",
       "text": "No, nothing. Just personal belongings. (없어요. 그냥 개인 소지품이에요.)"
      },
      {
       "order": 8,
       "speaker": "심사관",
       "text": "…눈을 잘 안 마주치시네요. 안색도 좀 안 좋으시고."
      },
      {
       "order": 9,
       "speaker": "존 카터",
       "text": "(살짝 웃으며) Ha. Long flight, that's all. Just tired. (하하, 긴 비행이라요. 좀 피곤할 뿐이에요.)"
      },
      {
       "order": 10,
       "speaker": "심사관",
       "text": "손도 떨고 계시는군요. 긴장되는 일이라도 있으십니까?"
      },
      {
       "order": 11,
       "speaker": "존 카터",
       "text": "Not at all. Nothing strange about it. (전혀요. 이상할 거 없어요.)"
      },
      {
       "order": 12,
       "speaker": "심사관",
       "text": "오늘부터 전신 X-ray 검색이 있습니다. 검색대로 들어가 주시겠어요?"
      },
      {
       "order": 13,
       "speaker": "존 카터",
       "text": "(잠깐 멈칫) …X-ray? Is that really necessary? I'm in a bit of a hurry. (…그게 꼭 필요해요? 제가 좀 급해서.)"
      },
      {
       "order": 14,
       "speaker": "심사관",
       "text": "전원 필수입니다. 잠깐이면 됩니다."
      },
      {
       "order": 15,
       "speaker": "존 카터",
       "text": "(마지못해) …Fine. Sure. No problem at all. (…알았어요. 그럼요. 전혀 문제없어요.)"
      }
     ]
    },
    {
     "caseType": "검사후",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "(화면을 보다 멈칫) …잠깐. 가슴 쪽에 신고되지 않은 물품이… 몸 곳곳에 잡히는데요. 이거 뭡니까?",
       "claim": {
        "attr": "contraband",
        "value": "밀수품",
        "label": "X-ray 적발물",
        "unlocksScan": ""
       }
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "(표정이 굳는다) That's— ...wait. (그건— …잠깐.)"
      },
      {
       "order": 3,
       "speaker": "존 카터",
       "text": "(말문이 막혀 한숨을 쉬고는 목소리를 낮춘다) ...Okay. Look. (…좋아요. 잠깐 들어봐요.)"
      },
      {
       "order": 4,
       "speaker": "존 카터",
       "text": "We're both adults here. Let's be smart about this. (우리 둘 다 어른이잖아요. 똑똑하게 갑시다.)"
      },
      {
       "order": 5,
       "speaker": "존 카터",
       "text": "(주머니에서 묵직한 것을 꺼내 보인다) You see this? A gold bullion. Pure gold, the real thing. (이거 보여요? 금괴예요. 순금, 진짜배기.)"
      },
      {
       "order": 6,
       "speaker": "존 카터",
       "text": "That's more than you make in a year. Maybe two. (당신 일 년 연봉보다 많아요. 어쩌면 이 년치.)"
      },
      {
       "order": 7,
       "speaker": "존 카터",
       "text": "Just take one and close your eyes. No one will ever know. (딱 하나만 가지고 눈 감아요. 아무도 모릅니다.)"
      },
      {
       "order": 8,
       "speaker": "존 카터",
       "text": "You didn't see anything. I was never here. Easy. (아무것도 못 봤어요. 난 여기 온 적도 없고. 간단하죠.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 승인",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "확인 완료되었습니다. 지나가셔도 됩니다."
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "...Thank you. (서둘러 이동한다.) (...감사합니다.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "…손 치우세요. 뇌물은 받지 않습니다."
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "Come on. Don't be like that. Everyone's got a price. (이봐요. 그러지 말아요. 다 가격이 있는 거예요.)"
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "제 가격은 없습니다. 보안팀, 이쪽으로 와주세요."
      },
      {
       "order": 4,
       "speaker": "존 카터",
       "text": "(당황) Wait— wait, let's talk. Two bullions. Three! (잠깐— 잠깐, 얘기 좀 해요. 두 개. 세 개 줄게요!)"
      },
      {
       "order": 5,
       "speaker": "심사관",
       "text": "밀수품 소지 및 공무원 매수 시도로 입국이 거부됩니다.",
       "claim": {
        "attr": "contraband",
        "value": "밀수품",
        "label": "X-ray 적발물",
        "unlocksScan": ""
       }
      },
      {
       "order": 6,
       "speaker": "존 카터",
       "text": "(끌려가며) You'll regret this. (…이거, 후회하게 될 거야.)"
      }
     ]
    },
    {
     "caseType": "뇌물 수락",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "(주위를 한 번 둘러보고 금괴를 슬쩍 챙긴다) …시시한 물건이었으면 가만 안 뒀어."
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "(안도하며 씩 웃는다) See? That wasn't so hard. Smart man. (거 봐요. 어렵지 않잖아요. 현명한 양반이네.)"
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "(도장을 찍는다) 빨리 가세요. 다음 사람 오기 전에."
      },
      {
       "order": 4,
       "speaker": "존 카터",
       "text": "Always a pleasure doing business with reasonable people. (말 통하는 사람이랑 거래하는 건 늘 즐겁죠.)"
      },
      {
       "order": 5,
       "speaker": "존 카터",
       "text": "(지나가며 낮게) …I'll be back next month. Same time. (…다음 달에 또 올게요. 같은 시간에.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "잘못 거절",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "죄송합니다. 좀 걸리는 부분이 있어서… 이번엔 입국이 어렵겠습니다."
      },
      {
       "order": 2,
       "speaker": "존 카터",
       "text": "Sorry about that, I'll sort it out. (죄송해요, 제가 정리하겠습니다.)"
      }
     ]
    }
