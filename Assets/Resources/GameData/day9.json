      "dialogueCases": [
        {
          "caseType": "입장",
          "gameResult": "-",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "윤정호",
              "text": "수고가 많으십니다. (정중하게 여권을 내밀며) 공무로 입국합니다. 잘 부탁드립니다."
            },
            {
              "order": 2,
              "speaker": "윤정호",
              "text": "(수행원이 대신 서류를 내밀며) 의원님 일정이 빠듯하오. 신속히 처리해 주시오."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "정상 승인",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "성공적인 회담 되십시오, 의원님."
            },
            {
              "order": 2,
              "speaker": "윤정호",
              "text": "수고하셨소. 나라를 위한 길에 늘 애써주시오."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "정상 거절",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "서류 항목에 문제가 있습니다. 입국은 어렵습니다."
            },
            {
              "order": 2,
              "speaker": "윤정호",
              "text": "지금 공무로 입국하는 사람을 막겠다는 거요? 누구 재가를 받았소?"
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "잘못 허가",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "확인 완료되었습니다. 지나가셔도 됩니다."
            },
            {
              "order": 2,
              "speaker": "윤정호",
              "text": "그래, 일을 알아서 처리할 줄 아는군. 기억해 두겠소."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "잘못 거절",
          "rejectCount": 1,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "죄송하지만 입국은 어렵습니다."
            },
            {
              "order": 2,
              "speaker": "윤정호",
              "text": "이런 식으로 일하면 곤란하오. 서류는 보좌관이 다 검토한 것이니 다시 보시오."
            },
            {
              "order": 3,
              "speaker": "심사관",
              "text": "다시 확인해보니 서류가 맞네요. 지나가시면 됩니다."
            },
            {
              "order": 4,
              "speaker": "윤정호",
              "text": "그럼 그렇지. 수고하시오."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "잘못 거절",
          "rejectCount": 2,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "죄송하지만 입국은 어렵습니다."
            },
            {
              "order": 2,
              "speaker": "윤정호",
              "text": "허, 내가 누군지 모르나? 의정활동에 차질이 생기면 자네가 책임질 텐가?"
            },
            {
              "order": 3,
              "speaker": "심사관",
              "text": "다시 확인했는데 서류가 모두 맞네요. 죄송합니다. 지나가셔도 됩니다."
            },
            {
              "order": 4,
              "speaker": "윤정호",
              "text": "진작 그럴 것이지. 공무 처리에 협조 좀 하시오."
            }
          ]
        },
        {
          "caseType": "일반 심사",
          "gameResult": "잘못 거절",
          "rejectCount": 3,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "죄송하지만 입국은 어렵습니다."
            },
            {
              "order": 2,
              "speaker": "윤정호",
              "text": "이 일이 기사로 나가도 좋겠소? 나는 국민의 표로 선 사람이오. 당장 통과시키시오!"
            },
            {
              "order": 3,
              "speaker": "심사관",
              "text": "고객님 서류 확인되셔서 바로 지나가시면 될 것 같습니다. 정말 죄송합니다."
            },
            {
              "order": 4,
              "speaker": "윤정호",
              "text": "흠... 이번 일은 잊지 않겠소. 다음부턴 알아서 처신하시게."
            }
          ]
        }
      ],
