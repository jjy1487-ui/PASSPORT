          "caseType": "일반 심사",
          "gameResult": "정상 거절",
          "rejectCount": 0,
          "lines": [
            {
              "order": 1,
              "speaker": "심사관",
              "text": "서류 항목에 문제가 있습니다. 입국은 어렵습니다."
