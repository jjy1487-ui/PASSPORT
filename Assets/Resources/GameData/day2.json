   "dialogueCases": [
    {
     "caseType": "입장",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "한지원",
       "text": "(선글라스를 살짝 내리며) 안녕하세요~ 아유, 밖에 팬분들 때문에 정신이 하나도 없네요."
      },
      {
       "order": 2,
       "speaker": "한지원",
       "text": "저 곧 해외 무대 리허설이 있어서요. 빨리 좀 부탁드릴게요. (여권을 내민다)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 1,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "여권 유효기간이 만료되어 입국하실 수 없습니다."
      },
      {
       "order": 2,
       "speaker": "한지원",
       "text": "네? 그럴 리가요. (당황) 다시 한 번만 봐주세요, 분명히 갱신했을 거예요."
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "다시 확인해도 만료일이 지났습니다."
      },
      {
       "order": 4,
       "speaker": "한지원",
       "text": "아니, 이게… 매니저가 처리했다고 했는데. 잠깐만요, 제가 전화 한 통만 해볼게요."
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 2,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "규정상 만료된 여권으로는 입국이 불가합니다."
      },
      {
       "order": 2,
       "speaker": "한지원",
       "text": "하… 저 진짜 큰일나요. 오늘 못 들어가면 무대가 펑크 난단 말이에요. 그거 누가 책임져요?"
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "죄송하지만 규정엔 예외가 없습니다."
      },
      {
       "order": 4,
       "speaker": "한지원",
       "text": "한 번만요, 네? 저 누군지 아시잖아요. 우리 좋게좋게 넘어가요."
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 3,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "마지막으로 말씀드립니다. 만료 여권은 입국이 불가합니다."
      },
      {
       "order": 2,
       "speaker": "한지원",
       "text": "(웃음기가 사라지며) …지금 진심으로 저 막으시는 거예요?"
      },
      {
       "order": 3,
       "speaker": "한지원",
       "text": "이거 제 팬들이 알면 가만 안 있어요. 버블에 실시간으로 올라가면 어떻게 되는지 아세요?!"
      },
      {
       "order": 4,
       "speaker": "심사관",
       "text": "그래도 입국은 허가해 드릴 수 없습니다. 돌아가 주십시오."
      },
      {
       "order": 5,
       "speaker": "한지원",
       "text": "(분을 삭이며 돌아선다) …이 일, 절대 그냥 안 넘어가요."
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "잘못 허가",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "…입국 허가합니다. 즐거운 방문 되십시오."
      },
      {
       "order": 2,
       "speaker": "한지원",
       "text": "어머, 감사합니다~! 역시 말이 통하네요. (선글라스 고쳐 쓰며 빠르게 사라진다)"
      }
     ]
    }
