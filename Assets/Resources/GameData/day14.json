   "dialogueCases": [
    {
     "caseType": "입장",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "강도식",
       "text": "어, 안녕하세요~ (여권을 천천히 꺼내며 태연하게 미소 짓는다.)"
      },
      {
       "order": 2,
       "speaker": "심사관",
       "text": "입국 목적이 어떻게 되십니까?"
      },
      {
       "order": 3,
       "speaker": "강도식",
       "text": "그냥 여행이요. 바람도 쐴 겸 해서. (선글라스 너머로 슬쩍 웃는다.)"
      },
      {
       "order": 4,
       "speaker": "심사관",
       "text": "신고할 물품 있으십니까?"
      },
      {
       "order": 5,
       "speaker": "강도식",
       "text": "없죠~ 그냥 개인 물건이에요. (손을 가볍게 흔들며)"
      },
      {
       "order": 6,
       "speaker": "심사관",
       "text": "…이 더운데 모자에 선글라스까지, 안 답답하세요?"
      },
      {
       "order": 7,
       "speaker": "강도식",
       "text": "하하, 제가 햇빛에 좀 약해서요. (대수롭지 않게)"
      },
      {
       "order": 8,
       "speaker": "심사관",
       "text": "오늘부터 전신 X-ray 검색이 있습니다. 검색대로 들어가 주시겠어요?"
      },
      {
       "order": 9,
       "speaker": "강도식",
       "text": "X-ray요? (선글라스를 만지작거리다) …그럼요. 전 숨길 것도 없는데요. (느긋하게 검색대로 들어선다)"
      }
     ]
    },
    {
     "caseType": "검사후",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "(화면을 보다 멈칫) …잠깐. 복부 쪽에 신고되지 않은 물질이… 마약류로 잡히는데요. 이거 뭡니까?",
       "claim": {
        "attr": "contraband",
        "value": "마약",
        "label": "X-ray 적발물",
        "unlocksScan": ""
       }
      },
      {
       "order": 2,
       "speaker": "강도식",
       "text": "(화면을 보고 잠깐 굳었다가) ...하. (선글라스를 천천히 내리며) 기계는 못 속이네요."
      },
      {
       "order": 3,
       "speaker": "강도식",
       "text": "(어조를 바꿔) 솔직히 말하죠. 우리 서로 시간 아끼고. 이 금괴 드릴게요."
      },
      {
       "order": 4,
       "speaker": "강도식",
       "text": "마약은 어차피 제가 쓸 거고, 당신한텐 피해 하나 없어요."
      },
      {
       "order": 5,
       "speaker": "강도식",
       "text": "금괴만 챙기시면 됩니다. 아무도 모르고, 아무 일도 없었던 거예요. 어때요?"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 승인",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "확인 완료되었습니다. 지나가셔도 됩니다."
      },
      {
       "order": 2,
       "speaker": "강도식",
       "text": "네. (안도하며 빠르게 사라진다.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 거절",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "…손 치우세요. 뇌물은 받지 않습니다."
      },
      {
       "order": 2,
       "speaker": "강도식",
       "text": "에이, 왜 이러세요. 다들 적당히 넘어가는데. (여유가 조금 사라진다.)"
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "마약 소지 및 공무원 매수 시도로 입국이 거부됩니다. 보안팀, 이쪽으로.",
       "claim": {
        "attr": "contraband",
        "value": "마약",
        "label": "X-ray 적발물",
        "unlocksScan": ""
       }
      },
      {
       "order": 4,
       "speaker": "강도식",
       "text": "(선글라스를 벗으며 표정이 굳는다) ...씨. 어쩔 수 없네요."
      },
      {
       "order": 5,
       "speaker": "강도식",
       "text": "(체념하며 손을 든다) ...뭐, 당신 같은 사람도 가끔 있긴 하네요."
      }
     ]
    },
    {
     "caseType": "뇌물 수락",
     "gameResult": "-",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "(주위를 한 번 둘러보고 금괴를 슬쩍 챙긴다) …시시한 물건이었으면 가만 안 뒀습니다."
      },
      {
       "order": 2,
       "speaker": "강도식",
       "text": "(씩 웃으며) 역시. 눈이 높으신 분이네요."
      },
      {
       "order": 3,
       "speaker": "심사관",
       "text": "(도장을 찍는다) 빨리 들어가세요. 뒤에 사람 있습니다."
      },
      {
       "order": 4,
       "speaker": "강도식",
       "text": "(선글라스를 고쳐 쓰며) 즐거운 거래였어요. 또 봬요~ (여유롭게 사라진다.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "잘못 거절",
     "rejectCount": 0,
     "lines": [
      {
       "order": 1,
       "speaker": "심사관",
       "text": "죄송합니다. 좀 걸리는 부분이 있어서… 이번엔 입국이 어렵겠습니다."
      },
      {
       "order": 2,
       "speaker": "강도식",
       "text": "(침묵 후) ...법적으로 대응할게요."
