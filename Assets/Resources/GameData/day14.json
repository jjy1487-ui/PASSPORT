       "order": 1,
       "speaker": "심사관",
       "text": "즐거운 여행 되세요!"
      },
      {
       "order": 2,
       "speaker": "와타나베 하나",
       "text": "ありがとう！韓国を楽しみます。 (감사합니다! 한국 여행 즐길게요.)"
      }
     ]
    },
