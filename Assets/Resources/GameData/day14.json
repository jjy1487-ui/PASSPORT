       "order": 4,
       "speaker": "와타나베 하나",
       "text": "パスポートをどうぞ。 (여기 여권 드릴게요.)"
      }
     ]
    },
    {
     "caseType": "일반 심사",
     "gameResult": "정상 승인",
     "rejectCount": 0,
     "lines": [
