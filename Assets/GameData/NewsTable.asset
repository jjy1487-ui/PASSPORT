    - "\uC785\uAD6D\uC7A5\uC11C \uC758\uB8CC\uAD00\uAD11\uAC1D \uC2E0\uC6D0 \uD655\uC778
      \uC9C0\uC5F0"
    - "\uC624\uB298 \uC624\uC804 \uAD6D\uC81C\uC120 \uC785\uAD6D\uC7A5\uC5D0\uC11C
      \uC758\uB8CC\uAD00\uAD11 \uBAA9\uC801 \uBC29\uBB38\uAC1D\uC758 \uC5EC\uAD8C
      \uC0AC\uC9C4\uACFC \uD604\uC7AC \uC5BC\uAD74\uC774 \uB2EC\uB77C \uCD94\uAC00
      \uD655\uC778\uC774 \uC9C4\uD589\uB410\uB2E4. \uC77C\uBD80 \uBC29\uBB38\uAC1D\uC740
      \uC218\uC220 \uC77C\uC815\uC744 \uC774\uC720\uB85C \uBE60\uB978 \uC2EC\uC0AC\uB97C
      \uC694\uCCAD\uD588\uC73C\uB098, \uD604\uC7A5\uC5D0\uC11C\uB294 \uC5EC\uAD8C\uACFC
      \uBE44\uC790 \uC815\uBCF4 \uB300\uC870\uAC00 \uC6B0\uC120 \uC801\uC6A9\uB410\uB2E4."
    - spr_news_001
  - keys:
    - news_id
    - day
    - news_title
    - news_content
    - icon_ref
    values:
    - 2
    - 4
    - "\uCE5C\uCC99 \uBC29\uBB38\uAC1D \uC11C\uB958 \uBD88\uC77C\uCE58\uB85C \uCD94\uAC00
      \uC870\uC0AC"
    - "\uCE5C\uCC99 \uBC29\uBB38\uC744 \uBAA9\uC801\uC73C\uB85C \uC785\uAD6D\uD558\uB824\uB358
      \uBC29\uBB38\uAC1D\uC758 \uC5EC\uAD8C \uC815\uBCF4\uC640 \uC81C\uCD9C \uC11C\uB958
      \uB0B4\uC6A9\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uCD94\uAC00 \uC870\uC0AC\uAC00
      \uC774\uB904\uC84C\uB2E4. \uACF5\uD56D \uAD00\uACC4\uC790\uB294 \uB2E8\uC21C
      \uC785\uB825 \uCC28\uC774\uCC98\uB7FC \uBCF4\uC774\uB294 \uC815\uBCF4\uB3C4
      \uBC18\uBCF5\uB418\uBA74 \uD5C8\uC704 \uC9C4\uC220 \uAC00\uB2A5\uC131\uC744
      \uD655\uC778\uD55C\uB2E4\uACE0 \uBC1D\uD614\uB2E4."
    - spr_news_002
  - keys:
    - news_id
    - day
    - news_title
    - news_content
    - icon_ref
    values:
    - 3
    - 5
    - "\uAC80\uC5ED\uB300\uC11C \uACE0\uC5F4 \uC758\uC2EC \uC2B9\uAC1D \uBD84\uB9AC
      \uC870\uCE58"
    - "\uC624\uB298 \uB0AE \uC785\uAD6D \uAC80\uC5ED\uB300\uC5D0\uC11C \uACE0\uC5F4
      \uC99D\uC0C1\uC744 \uBCF4\uC778 \uBC29\uBB38\uAC1D\uC774 \uD655\uC778\uB3FC
      \uC784\uC2DC \uB300\uAE30 \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD588\uB2E4.
      \uAC19\uC740 \uC2DC\uAC04\uB300 \uC785\uAD6D\uC790 \uC77C\uBD80\uB3C4 PCR \uAC80\uC0AC\uC11C\uC640
      \uAC74\uAC15 \uC0C1\uD0DC\uB97C \uCD94\uAC00 \uD655\uC778\uBC1B\uC73C\uBA70
      \uAC80\uC5ED \uC808\uCC28\uAC00 \uC9C0\uC5F0\uB410\uB2E4."
    - spr_news_003
  - keys:
    - news_id
    - day
    - news_title
    - news_content
    - icon_ref
    values:
    - 4
    - 7
    - "PCR \uC11C\uB958 \uB204\uB77D\uC73C\uB85C \uC785\uAD6D\uC7A5 \uB300\uAE30\uC5F4
      \uD63C\uC7A1"
    - "\uAC15\uD654\uB41C \uAC80\uC5ED \uC808\uCC28\uAC00 \uC774\uC5B4\uC9C0\uB294
      \uAC00\uC6B4\uB370 PCR \uAC80\uC0AC\uC11C\uB97C \uC81C\uCD9C\uD558\uC9C0 \uC54A\uAC70\uB098
      \uAC80\uC0AC \uAE30\uAD00 \uC815\uBCF4\uAC00 \uBD88\uBA85\uD655\uD55C \uC0AC\uB840\uAC00
      \uC787\uB530\uB790\uB2E4. \uD604\uC7A5\uC5D0\uC11C\uB294 \uC11C\uB958 \uD655\uC778\uC774
      \uAE38\uC5B4\uC9C0\uBA70 \uC785\uAD6D \uB300\uAE30\uC5F4\uC774 \uD55C\uB54C
      \uD06C\uAC8C \uB298\uC5B4\uB0AC\uB2E4."
    - spr_news_004
  - keys:
    - news_id
    - day
    - news_title
    - news_content
    - icon_ref
    values:
    - 5
    - 8
    - "\uC7A5\uAE30 \uCCB4\uB958\uC790 \uC11C\uB958 \uB300\uC870\uC911 \uBD88\uC77C\uCE58
      \uD655\uC778"
    - "\uCDE8\uC5C5\uACFC \uC720\uD559 \uB4F1 \uC7A5\uAE30 \uCCB4\uB958 \uBAA9\uC801
      \uC785\uAD6D\uC790 \uC2EC\uC0AC \uACFC\uC815\uC5D0\uC11C \uCCB4\uB958 \uBAA9\uC801\uACFC
      \uC81C\uCD9C \uC11C\uB958\uAC00 \uB9DE\uC9C0 \uC54A\uB294 \uC0AC\uB840\uAC00
      \uD655\uC778\uB410\uB2E4. \uB2F9\uAD6D\uC740 \uC5EC\uAD8C, \uBE44\uC790, \uCCB4\uB958
      \uBAA9\uC801 \uC11C\uB958\uC758 \uC815\uBCF4\uAC00 \uC11C\uB85C \uC774\uC5B4\uC9C0\uB294\uC9C0
      \uD655\uC778\uD558\uACE0 \uC788\uB2E4."
    - spr_news_005
  - keys:
    - news_id
    - day
    - news_title
    - news_content
    - icon_ref
    values:
    - 6
    - 10
    - "\uC644\uBCBD\uD574 \uBCF4\uC778 \uC11C\uB958, \uD1B5\uACFC \uC9C1\uC804 \uC704\uC870
      \uC801\uBC1C"
    - "\uC624\uB298 \uC2EC\uC0AC \uACFC\uC815\uC5D0\uC11C \uAC89\uBCF4\uAE30\uC5D0\uB294
      \uC774\uC0C1\uC774 \uC5C6\uB358 \uC11C\uB958\uAC00 \uCD5C\uC885 \uD655\uC778
      \uB2E8\uACC4\uC5D0\uC11C \uC704\uC870\uB85C \uB4DC\uB7EC\uB0AC\uB2E4. \uBCF4\uC548
      \uAD00\uACC4\uC790\uB294 \uBB38\uC11C \uBC88\uD638\uC640 \uBC1C\uAE09 \uC815\uBCF4\uC758
      \uC791\uC740 \uCC28\uC774\uAC00 \uB2E8\uC11C\uAC00 \uB410\uB2E4\uACE0 \uC804\uD588\uB2E4."
    - 
  - keys:
    - news_id
    - day
    - news_title
    - news_content
    - icon_ref
    values:
    - 7
    - 11
    - "\uC778\uC0C1 \uBC14\uAFBC \uC218\uBC30\uC790 \uD6C4\uBCF4, \uC2EC\uC0AC\uB300\uC11C
      \uD3EC\uCC29"
    - "\uC131\uD615\uC73C\uB85C \uC778\uC0C1\uC774 \uB2EC\uB77C\uC9C4 \uC218\uBC30\uC790
      \uD6C4\uBCF4\uAC00 \uC785\uAD6D \uC2EC\uC0AC \uACFC\uC815\uC5D0\uC11C \uD3EC\uCC29\uB410\uB2E4.
      \uBCF4\uC548\uD300\uC740 \uC5EC\uAD8C \uC0AC\uC9C4\uB9CC\uC73C\uB85C \uD655\uC778\uC774
      \uC5B4\uB824\uC6B4 \uACBD\uC6B0\uC5D0\uB3C4 \uC9C4\uC220, \uC2E0\uC6D0 \uC815\uBCF4,
      \uD589\uB3D9 \uAE30\uB85D\uC744 \uD568\uAED8 \uB300\uC870\uD558\uACE0 \uC788\uB2E4\uACE0
      \uBC1D\uD614\uB2E4."
    - 
  - keys:
    - news_id
    - day
    - news_title
    - news_content
    - icon_ref
    values:
    - 8
    - 12
    - "\uB3C4\uC2EC \uD3ED\uBC1C \uC218\uC0AC, \uACF5\uD56D \uC774\uB3D9 \uAE30\uB85D\uC73C\uB85C
      \uD655\uB300"
    - "\uB3C4\uC2EC \uD3ED\uBC1C \uC0AC\uAC74 \uC774\uD6C4 \uC218\uC0AC \uB2F9\uAD6D\uC774
      \uC704\uC870 \uC2E0\uBD84 \uC0AC\uC6A9 \uAC00\uB2A5\uC131\uACFC \uACF5\uD56D
      \uC774\uB3D9 \uAE30\uB85D\uC744 \uD568\uAED8 \uC870\uC0AC\uD558\uACE0 \uC788\uB2E4.
      \uC624\uB298 \uC785\uAD6D\uC7A5\uC5D0\uC11C\uB294 \uBAA9\uC801 \uC9C4\uC220\uC740
      \uC790\uC5F0\uC2A4\uB7EC\uC6E0\uC9C0\uB9CC \uD589\uB3D9\uACFC \uC11C\uB958
      \uD750\uB984\uC774 \uB9DE\uC9C0 \uC54A\uB294 \uBC29\uBB38\uAC1D\uC774 \uCD94\uAC00
      \uD655\uC778\uC744 \uBC1B\uC558\uB2E4."
    - 
  - keys:
    - news_id
