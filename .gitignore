# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Memory captures and profiling
[Mm]emoryCaptures/
Recordings/

# Autogenerated solution/project files
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity cache / crash files
sysinfo.txt
*.stackdump
*.tmp
*.bak

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
*.apk
*.aab
*.unitypackage
# Releases: track packaged .zip only, ignore raw build output folders
/Releases/*/

# Python
__pycache__/
*.pyc

# Excel temp lock files
~$*

# Tool-generated backups (canonical state is committed in git)
*.bak_*
*.bak.meta
_backup_*
_bak_*
/_disabled_briefing/
_inject_crosscheck_log.txt

# Unity crash recovery
Assets/_Recovery/
Assets/_Recovery.meta
